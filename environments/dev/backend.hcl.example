# Copy to backend.hcl (git-ignored) and fill in 'bucket' and 'dynamodb_table'
# with the outputs from `bootstrap/`. CI takes the other settings from this
# file and supplies the bucket from the TF_STATE_BUCKET secret.
bucket         = "CHANGE-ME-url-shortener-tfstate"
key            = "url-shortener/dev/terraform.tfstate"
region         = "eu-central-1"
dynamodb_table = "terraform-locks"
encrypt        = true
